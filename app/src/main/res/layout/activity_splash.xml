<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sunset"
        android:contentDescription="App Logo Background"
        android:scaleType="centerCrop" />

    <!-- Overlay to make text readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">


    <!-- campfire emoji as the logo - simple and fits the theme -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#x1F525;"
        android:textSize="90sp"
        android:layout_marginBottom="16dp"/>
    <!-- app title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CAMPSITECOMMANDER"
        android:layout_gravity="center"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"/>
    <!-- subtitle under the title -->

    <!-- my name and student number so the marker knows whose app this is -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developer: Donald Prosper Mudzani"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="italic"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Number: ST10512213.."
        android:textColor="#C8E6C9"
        android:textSize="14sp"/>
    <Button android:id="@+id/btnStart"
        android:layout_width="200dp" android:layout_height="wrap_content"
        android:text="Start" android:backgroundTint="#42A5F5"
        android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btnExit"
        android:layout_width="200dp" android:layout_height="wrap_content"
        android:text="Exit" android:backgroundTint="#EF5350" />

</LinearLayout>
</FrameLayout>